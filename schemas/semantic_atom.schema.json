{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DIKWP-MESH2 Semantic Atom",
  "type": "object",
  "required": ["id", "label", "observer", "context", "type_weights"],
  "properties": {
    "id": {"type": "string"},
    "label": {"type": "string"},
    "observer": {"type": "string"},
    "context": {"type": "string"},
    "type_weights": {
      "type": "object",
      "required": ["D", "I", "K", "W", "P"],
      "properties": {
        "D": {"type": "number", "minimum": 0},
        "I": {"type": "number", "minimum": 0},
        "K": {"type": "number", "minimum": 0},
        "W": {"type": "number", "minimum": 0},
        "P": {"type": "number", "minimum": 0}
      }
    },
    "tags": {"type": "array", "items": {"type": "string"}},
    "stance": {"type": "object", "additionalProperties": {"type": "number", "minimum": -1, "maximum": 1}},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
